# ========================================================
# GlowGuide AI Makeup - Production Environment Variables
# ========================================================

# Application Settings
PROJECT_NAME="GlowGuide AI Makeup"
ENVIRONMENT="production"
DEBUG=false

# Database Configuration
# For production Docker with PostgreSQL:
DATABASE_URL="postgresql+psycopg://glowguide_user:glowguide_secure_password@localhost:5432/glowguide_db"
# For local lightweight dev without Docker:
# DATABASE_URL="sqlite+aiosqlite:///./beauty_makeup.db"

# Price & Catalogue Freshness Policy
PRICE_STALE_HOURS=24

# Photo Privacy Safeguards
ALLOW_FACE_STORAGE=false
FACE_PROCESSING_IN_MEMORY_ONLY=true
MAX_IMAGE_UPLOAD_BYTES=5242880

# ========================================================
# Retailer Credentials (Backend Only - Never Expose to Client)
# ========================================================

# 1. Amazon India (Amazon Associates / Creators API & PA-API 5.0)
# Requirements: Active Associates account with 10 qualifying referred sales in last 30 days
AMAZON_ACCESS_KEY_ID=""
AMAZON_SECRET_KEY=""
AMAZON_ASSOCIATE_TAG="" # e.g., "yourtag-21"
AMAZON_HOST="webservices.amazon.in"

# 2. Cuelinks Developer Pub API v3
# Requirements: Approved publisher account & developer API key from https://developers.cuelinks.com
CUELINKS_API_TOKEN=""
CUELINKS_PUB_ID=""
CUELINKS_CHANNEL_ID=""

# 3. Nykaa Affiliate Program
# Requirements: 5,000+ followers or creator approval from https://affiliate.nykaa.com
NYKAA_AFFILIATE_ID=""
NYKAA_TRACKING_PREFIX=""
